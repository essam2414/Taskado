@service(serviceClass)
entity ProductivityReport {
  tasksPlanned Integer required min(0),        // How many tasks were planned
  tasksCompleted Integer required min(0),      // How many tasks were completed
  pomodoroSessionsCompleted Integer required min(0), // Pomodoro cycles finished
  totalFocusTime Float min(0),                 // Total time spent in focus (in hours)
  distractionsCount Integer min(0),            // Number of distractions recorded
  efficiencyScore Float min(0) max(100),       // Performance score (calculated from tasks & focus)
  timestamp Instant required                   // When report was generated
}

relationship ManyToOne {
  ProductivityReport{user} to User with builtInEntity
}

relationship OneToMany {
  ProductivityReport{pomodoroSessions} to PomodoroSession
}

relationship ManyToMany {
  ProductivityReport{completedTasks} to Task,
  ProductivityReport{completedHabits} to Habit
}