entity Category {
  name String required unique,
  color String required
}

entity Task {
  title String required,
  description String,
  dueDate Instant,
  priority Priority,
  completed Boolean,
  createdAt Instant,
  updatedAt Instant,
  order Integer
}

entity Section {
  name String required
}

entity Event {
  title String required,
  description String,
  eventDate Instant required,
  startTime Instant required,
  endTime Instant required,
  location String,
  reminder Boolean
}

entity Habit {
  name String required,
  startDate Instant required,
  streak Integer,
  completionRate Float,

  repeatType String required,
  repeatInterval Integer,
  repeatDays String,
  repeatTimes String,

  completedDates TextBlob
}

enum NotificationType {
  REMINDER,
  DEADLINE,
  SYSTEM_UPDATE
}

enum Priority {
  LOW,
  MEDIUM,
  HIGH,
  CRITICAL
}

enum NotificationStatus {
  SENT,
  PENDING,
  FAILED
}

enum NotificationChannel {
  EMAIL,
  SMS,
  PUSH
}

entity Notification {
  message String required,
  notificationType NotificationType required,
  createdAt Instant required,
  read Boolean required,
  priority Priority required,
  status NotificationStatus required,
  sentVia NotificationChannel required
}

entity Reminder {
  title String required,
  description String,
  reminderDate Instant required,
  repeatType String,
  repeatInterval Integer,
  linkedEntityType String,
  linkedEntityId Long
}

entity PomodoroSession {
  name String,
  duration Integer required,
  breakDuration Integer required,
  longBreakDuration Integer,
  cycles Integer required,
  startTime Instant required,
  endTime Instant,
  completed Boolean required
}

entity Note {
  title String required,
  content TextBlob required,
  createdAt Instant required,
  updatedAt Instant
}

@service(serviceClass)
entity ProductivityReport {
  tasksPlanned Integer required min(0),        // How many tasks were planned
  tasksCompleted Integer required min(0),      // How many tasks were completed
  pomodoroSessionsCompleted Integer required min(0), // Pomodoro cycles finished
  totalFocusTime Float min(0),                 // Total time spent in focus (in hours)
  distractionsCount Integer min(0),            // Number of distractions recorded
  efficiencyScore Float min(0) max(100),       // Performance score (calculated from tasks & focus)
  timestamp Instant required                   // When report was generated
}

relationship OneToMany {
  ProductivityReport{pomodoroSessions} to PomodoroSession,
  Section{tasks} to Task{section}
}

relationship ManyToMany {
  ProductivityReport{completedTasks} to Task,
  ProductivityReport{completedHabits} to Habit
}

relationship ManyToOne {
  Task{category} to Category,
  Habit{category} to Category,
  Note{category} to Category,
  Task{user} to User with builtInEntity,
  Habit{user} to User with builtInEntity,
  Event{user} to User with builtInEntity,
  Notification{user} to User with builtInEntity,
  Reminder{user} to User with builtInEntity,
  ProductivityReport{user} to User with builtInEntity,
  PomodoroSession{user} to User with builtInEntity,
  Note{user} to User with builtInEntity,
}