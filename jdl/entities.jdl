entity Task {
  title String required,
  description String,
  dueDate Instant required,
  priority Priority,
  category TaskCategory,
  completed Boolean,
  createdAt Instant,
  updatedAt Instant
}

enum TaskCategory {
  WORK,
  PERSONAL,
  HEALTH,
  EDUCATION,
  OTHER
}

entity Event {
  title String required,
  description String,
  eventDate Instant required,
  startTime Instant required,
  endTime Instant required,
  location String,
  reminder Boolean
}

entity Habit {
    name String required,
    repeatFrequency String required,
    startDate Instant required,
    streak Integer,
    completionRate Float
}

enum NotificationType {
  REMINDER,
  DEADLINE,
  SYSTEM_UPDATE
}

enum Priority {
  LOW,
  MEDIUM,
  HIGH,
  CRITICAL
}

enum NotificationStatus {
  SENT,
  PENDING,
  FAILED
}

enum NotificationChannel {
  EMAIL,
  SMS,
  PUSH
}

entity Notification {
  message String required,
  notificationType NotificationType required,
  timestamp Instant required,
  linkedEntityType String,
  read Boolean required,
  priority Priority required,
  status NotificationStatus required,
  expirationDate Instant,
  actionURL String,
  icon String,
  isRecurring Boolean required,
  recurrencePattern String,
  sentVia NotificationChannel required
}

entity Goal {
  title String required,
  description String,
  startDate Instant required,
  endDate Instant,
  progress Integer

}

entity ProductivityReport {
  tasksPlanned Integer,
  tasksCompleted Integer,
  taskAvgCompletionTime Float,   // Average time spend per task
  taskEfficiency Float,          // Ratio of completed vs planned tasks
  pomodoroSessions Integer,      // Successful pomodoro sessions
  distractionsCount Integer,     // Counts recorded distractions
  focusTime Float,               // Time taken in focus sessions
  focusScore Float required,     // Score calculated from completed tasks and pomodoro session data
  timestamp Instant required     // When report generated
}

entity PomodoroSession {
  Start Instant required,
  Stop Instant,
  duration Integer,
  Paused Boolean,
}

relationship ManyToOne {
  Task{user} to User with builtInEntity,
  Habit{user} to User with builtInEntity,
  Event{user} to User with builtInEntity,
  Notification{user} to User with builtInEntity,
  Goal{user} to User with builtInEntity,
  ProductivityReport{user} to User with builtInEntity,
  PomodoroSession{user} to User with builtInEntity
}
