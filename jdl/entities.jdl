entity User {
  fullName String required,
  email String required
}

entity Task {
  title String required,
  description String,
  dueDate Instant required,
  priority Integer,
  completed Boolean,

}

entity Event {
  title String required,
  description String,
  eventDate Instant required,
  startTime Instant required,
  endTime Instant required,
  location String,
  reminder Boolean
}

entity Habit {
    name String required,
    repeatFrequency String required,
    startDate Instant required,
    streak Integer,
    completionRate Float
}

enum NotificationType {
  REMINDER,
  DEADLINE,
  SYSTEM_UPDATE
}

enum Priority {
  LOW,
  MEDIUM,
  HIGH,
  CRITICAL
}

enum NotificationStatus {
  SENT,
  PENDING,
  FAILED
}

enum NotificationChannel {
  EMAIL,
  SMS,
  PUSH
}

entity Notification {
  message String required,
  notificationType NotificationType required,
  timestamp Instant required,
  linkedEntityType String,
  read Boolean required,
  priority Priority required,
  status NotificationStatus required,
  expirationDate Instant,
  actionURL String,
  icon String,
  isRecurring Boolean required,
  recurrencePattern String,
  sentVia NotificationChannel required
}

enum PomodoroType {
  Standard,
  Meditation,
  Study,
  Physical
}

entity PomodoroSession {
  Start Instant required,
  end Instant,
  duration Integer,
  type PomodoroType required,
  Paused Boolean,
  Observations String
}



relationship ManyToOne {
  Task{user} to User
  Habit{user} to User
  Event{user} to User
  Notification{user} to User
  PomodoroSession{user} to User
}
