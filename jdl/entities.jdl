entity Category {
  name String required unique,
  color String required
}

entity Task {
  title String required,
  description String,
  dueDate Instant,
  priority Priority,
  completed Boolean,
  createdAt Instant,
  updatedAt Instant
}

entity Event {
  title String required,
  description String,
  eventDate Instant required,
  startTime Instant required,
  endTime Instant required,
  location String,
  reminder Boolean
}

entity Habit {
  name String required,
  repeatType String required,
  repeatInterval Integer,
  repeatDays String,
  repeatTimes String,
  completed Boolean required,
  startDate Instant required,
  streak Integer,
  completionRate Float
}

enum NotificationType {
  REMINDER,
  DEADLINE,
  SYSTEM_UPDATE
}

enum Priority {
  LOW,
  MEDIUM,
  HIGH,
  CRITICAL
}

enum NotificationStatus {
  SENT,
  PENDING,
  FAILED
}

enum NotificationChannel {
  EMAIL,
  SMS,
  PUSH
}

entity Notification {
  message String required,
  notificationType NotificationType required,
  timestamp Instant required,
  linkedEntityType String,
  read Boolean required,
  priority Priority required,
  status NotificationStatus required,
  expirationDate Instant,
  actionURL String,
  icon String,
  isRecurring Boolean required,
  recurrencePattern String,
  sentVia NotificationChannel required
}

entity Note {
  title String required,
  content TextBlob required,
  createdAt Instant required, 
  uupdatedAt Instant
}

entity ProductivityReport {
  tasksPlanned Integer,
  tasksCompleted Integer,
  taskAvgCompletionTime Float,
  taskEfficiency Float,
  pomodoroSessions Integer,
  distractionsCount Integer,
  focusTime Float,
  focusScore Float required,
  timestamp Instant required
}

entity PomodoroSession {
  start Instant required,
  stop Instant,
}

relationship ManyToOne {
  Task{category} to Category,
  Habit{category} to Category,
  Task{user} to User with builtInEntity,
  Habit{user} to User with builtInEntity,
  Event{user} to User with builtInEntity,
  Notification{user} to User with builtInEntity,
  Note{user} to User with builtInEntity,
  ProductivityReport{user} to User with builtInEntity,
  PomodoroSession{user} to User with builtInEntity
}
