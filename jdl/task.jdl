entity Category {
  name String required unique,
  color String required
}

entity Task {
  title String required,
  description String,
  dueDate Instant,
  priority TaskPriority,
  completed Boolean,
  createdAt Instant,
  updatedAt Instant
}

enum TaskPriority {
  LOW,
  MEDIUM,
  HIGH,
  URGENT
}

relationship ManyToOne {
  Task{category} to TaskCategory  
  Task{user} to User
}