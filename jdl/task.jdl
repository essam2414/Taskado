entity TaskCategory {
  name String required unique
}

entity Task {
  title String required,
  description String,
  dueDate Instant,
  priority TaskPriority,
  completed Boolean,
  createdAt Instant,
  updatedAt Instant
}

enum TaskPriority {
  LOW,
  MEDIUM,
  HIGH,
  URGENT
}

relationship ManyToOne {
  Task{category} to TaskCategory  
  Task{user(login)} to User
}